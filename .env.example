APP_NAME="Bantuin Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DOCS_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=HirePilot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ASSESSMENT_PASSING_SCORE=75
ASSESSMENT_RESUME_MAX_KB=5120
# Optional override; default uses Spatie auto-discovery (e.g. /usr/bin/pdftotext)
# ASSESSMENT_PDFTOTEXT_BIN=/usr/bin/pdftotext
ASSESSMENT_RANKING_RESUME_WEIGHT=35
ASSESSMENT_RANKING_ESSAY_WEIGHT=50
ASSESSMENT_RANKING_MCQ_WEIGHT=15
ASSESSMENT_EVALUATION_REPAIR_ATTEMPTS=1
ASSESSMENT_QWEN_TRANSPORT_ATTEMPTS=2
ASSESSMENT_QWEN_TRANSPORT_RETRY_SLEEP_MS=300
ASSESSMENT_EVALUATION_PROCESSING_MARGIN=30
# Default: (QWEN_TIMEOUT * transport attempts * (1 + repair + critic)) + processing margin = 210
ASSESSMENT_EVALUATION_JOB_TIMEOUT=210
ASSESSMENT_QUEUE_RETRY_AFTER_SAFETY_MARGIN=60
# Must exceed ASSESSMENT_EVALUATION_JOB_TIMEOUT + safety margin
ASSESSMENT_QUEUE_RETRY_AFTER=270
DB_QUEUE_RETRY_AFTER=270
REDIS_QUEUE_RETRY_AFTER=270
ASSESSMENT_GENERATOR_PROMPT_VERSION=1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
