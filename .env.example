APP_NAME="Bantuin Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DOCS_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=HirePilot
DB_USERNAME=postgres
DB_PASSWORD=
# Optional database used by the PostgreSQL integration test suite
# POSTGRES_INTEGRATION_DATABASE=bantuin_integration

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ASSESSMENT_PASSING_SCORE=75
ASSESSMENT_RESUME_MAX_KB=5120
ASSESSMENT_RESUME_MAX_EXTRACTED_CHARACTERS=30000
# Optional override; default uses Spatie auto-discovery (e.g. /usr/bin/pdftotext)
# ASSESSMENT_PDFTOTEXT_BIN=/usr/bin/pdftotext
ASSESSMENT_EVALUATION_REPAIR_ATTEMPTS=1
ASSESSMENT_EVALUATION_MINIMUM_CONFIDENCE=70
ASSESSMENT_EVALUATION_REVIEW_MARGIN=3
ASSESSMENT_QWEN_TRANSPORT_ATTEMPTS=2
ASSESSMENT_QWEN_TRANSPORT_RETRY_SLEEP_MS=300
ASSESSMENT_RESUME_PROCESSING_MARGIN=30
# Default: (QWEN_TIMEOUT * transport attempts) + processing margin = 90
ASSESSMENT_RESUME_JOB_TIMEOUT=90
ASSESSMENT_EVALUATION_PROCESSING_MARGIN=30
# Default: (2 Max reasoners * 120s * 2 attempts) + (3 structured calls * 30s * 2 attempts) + margin = 690
ASSESSMENT_EVALUATION_JOB_TIMEOUT=690
ASSESSMENT_QUEUE_RETRY_AFTER_SAFETY_MARGIN=60
# Must exceed ASSESSMENT_EVALUATION_JOB_TIMEOUT + safety margin
ASSESSMENT_QUEUE_RETRY_AFTER=750
# Must be at least the queue retry-after/visibility window
ASSESSMENT_EXTERNAL_WORK_STALE_AFTER=750
DB_QUEUE_RETRY_AFTER=750
REDIS_QUEUE_RETRY_AFTER=750
ASSESSMENT_GENERATOR_PROMPT_VERSION=2
ASSESSMENT_EXAM_REQUIRE_FULLSCREEN=true
ASSESSMENT_EXAM_MAX_INTEGRITY_WARNINGS=3
ASSESSMENT_EXAM_AUTO_SUBMIT_ON_MAX_WARNINGS=true
ASSESSMENT_EXAM_BLOCK_COPY_PASTE=true
ASSESSMENT_EXAM_ENFORCE_SECTION_TIMERS=true
ASSESSMENT_EXAM_MAX_ANSWER_CHARACTERS=20000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_PROVIDER=qwen
QWEN_MODEL=qwen3.7-plus
QWEN_REASONER_MODEL=qwen3.7-max
QWEN_STRUCTURED_MODEL=qwen3.7-plus
QWEN_TIMEOUT=30
QWEN_REASONER_TIMEOUT=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=https://files.example.com
R2_REGION=auto
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
